# Tomo 仓库根目录（文档存放位置）
TOMO_REPO_PATH=./tomo-docs

# 服务端口
PORT=4000

# 用户数据文件（JSON，独立于文档仓库）
TOMO_USERS_FILE=./.tomo/users.json

# 会话签名密钥（生产环境务必改成随机长字符串）
TOMO_SESSION_SECRET=tomo-dev-secret-change-me

# 首次启动种子管理员账号（仅当用户文件为空时创建，登录后请尽快改密码）
TOMO_ADMIN_USER=admin
TOMO_ADMIN_PASSWORD=admin

# Git commit 作者信息
TOMO_GIT_AUTHOR_NAME=Tomo
TOMO_GIT_AUTHOR_EMAIL=tomo@local
